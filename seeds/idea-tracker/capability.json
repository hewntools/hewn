          "url": { "type": "string", "maxLength": 500, "description": "Optional http(s) link, max 500 chars; '' means none" },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxItems": 50, "description": "Tags; normalized to lowercase-hyphenated, max 20 per idea, max 40 chars each" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Gut rating 1–5 stars" },
          "status": { "type": "string", "enum": ["raw", "exploring", "validating", "active", "parked", "shipped", "killed"], "description": "Defaults to raw. active: the owner is working on or building it now. parked: on hold, still open. shipped: the idea became a real, live thing" },
          "note": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S", "description": "Optional first note" }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
