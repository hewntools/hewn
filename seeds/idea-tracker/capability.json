      "description": "Log a new idea. Only title is required; pitch, url (http/https), tags, rating (1–5), status and a first note are optional. Statuses in lifecycle order: raw, exploring, validating, active (being worked on or built now), parked (on hold, still open), shipped, killed. Open = raw, exploring, validating, active, parked; closed = shipped, killed.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Optional client-chosen id; a short random id is generated when omitted" },
