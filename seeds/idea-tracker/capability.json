{
  "id": "idea-tracker",
  "name": "Idea Tracker",
  "purpose": "Capture business and product ideas quickly and see the best ones first. Each idea has a one-line pitch, an optional link, tags, a status (raw, exploring, validating, active, parked, shipped, killed), a 1–5 star gut rating and dated notes as it develops.",
  "abi": "2.0",
  "hue": 48,
  "tags": ["ideas", "business", "notes"],
  "ui": { "available": true },
  "operations": [
    {
      "name": "add_idea",
      "version": 1,
      "sideEffect": "write",
      "description": "Log a new idea. Only title is required; pitch, url, tags, rating (1–5), status and a first note are optional. Contract v1 reports a 'shipped' idea as status 'parked' and an 'active' idea as 'validating'; use v3 to see both.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,39}$", "description": "Optional client-chosen id; a short random id is generated when omitted" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S", "description": "Idea title, 1–200 chars after trimming" },
          "pitch": { "type": "string", "maxLength": 500, "description": "One-line pitch, max 500 chars; newlines become spaces" },
          "url": { "type": "string", "maxLength": 500, "description": "Optional http(s) link, max 500 chars; '' means none" },
          "tags": { "type": "array", "items": { "type": "string", "maxLength": 100 }, "maxItems": 50, "description": "Tags; normalized to lowercase-hyphenated, max 20 per idea, max 40 chars each" },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Gut rating 1–5 stars" },
          "status": { "type": "string", "enum": ["raw", "exploring", "validating", "parked", "killed"], "description": "Defaults to raw" },
          "note": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S", "description": "Optional first note" }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "pitch": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["raw", "exploring", "validating", "parked", "killed"] },
          "rating": { "type": ["integer", "null"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "note_count": { "type": "integer" },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "status_changed_at": { "type": "string" },
          "notes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "body": { "type": "string" }, "created_at": { "type": "string" } },
              "required": ["id", "body", "created_at"]
            }
          }
        },
        "required": ["id", "title", "pitch", "status", "rating", "tags", "note_count", "created_at", "updated_at", "status_changed_at", "notes"]
      }
    },
    {
