          "note": { "type": "string", "minLength": 1, "maxLength": 5000, "pattern": "\\S", "description": "Optional first note" }
        },
        "required": ["title"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "pitch": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "status": { "type": "string", "enum": ["raw", "exploring", "validating", "parked", "killed", "shipped"] },
