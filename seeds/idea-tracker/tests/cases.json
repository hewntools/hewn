  },
  {
    "name": "v2 update_idea to shipped",
    "operation": "update_idea", "version": 2,
    "input": { "id": "sh3", "status": "shipped" },
    "expect": { "id": "sh3", "status": "shipped", "url": null, "status_changed_at": "$any" }
  },
  {
    "name": "v2 list_ideas hides shipped by default",
