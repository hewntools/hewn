[
  { "name": "empty nightstand", "operation": "widget_nightstand", "input": {},
    "expect": { "small": { "template": "stat", "value": 0 }, "medium": { "template": "list", "items": [] } } },
  { "name": "add a book to read later", "operation": "add_book",
    "input": { "title": "The Left Hand of Darkness", "author": "Ursula K. Le Guin", "pages": 304 },
    "expect": { "bookId": "$any" } },
  { "name": "add one being read", "operation": "add_book",
    "input": { "title": "Middlemarch", "author": "George Eliot", "pages": 880, "status": "reading" },
    "expect": { "bookId": "$any" } },
  { "name": "list what's being read", "operation": "list_books", "input": { "status": "reading" },
    "expect": { "books": [{ "title": "Middlemarch", "status": "reading", "page": 0 }] } },
  { "name": "nightstand shows it", "operation": "widget_nightstand", "input": {},
    "expect": { "small": { "template": "progress", "value": 0, "max": 880, "label": "Middlemarch" },
                "medium": { "template": "list", "items": [{ "title": "Middlemarch", "detail": "George Eliot", "value": "0%" }] } } },
  { "name": "unknown book", "operation": "set_progress", "input": { "bookId": "nope", "page": 10 }, "expectError": true },
  { "name": "rejects a rating out of range", "operation": "finish_book", "input": { "bookId": "nope", "rating": 6 }, "expectError": true },
  { "name": "rejects unknown field", "operation": "add_book", "input": { "title": "X", "genre": "sf" }, "expectError": true },
  { "name": "list everything", "operation": "list_books", "input": {},
    "expect": { "books": [{ "title": "Middlemarch" }, { "title": "The Left Hand of Darkness", "status": "want" }] } },
  { "name": "ids read like the title", "operation": "add_book", "input": { "title": "Piranesi", "pages": 272 },
    "expect": { "bookId": "piranesi" } },
  { "name": "a second copy gets its own id", "operation": "add_book", "input": { "title": "Piranesi" },
    "expect": { "bookId": "piranesi-2" } },
  { "name": "accents fold into the id", "operation": "add_book", "input": { "title": "Rött, vitt & kungligt blå" },
    "expect": { "bookId": "rott-vitt-kungligt-bla" } },
  { "name": "set the page", "operation": "set_progress", "input": { "bookId": "middlemarch", "page": 220 },
    "expect": { "bookId": "middlemarch", "page": 220, "percent": 25 } },
  { "name": "a page past the end stops at the last page", "operation": "set_progress", "input": { "bookId": "middlemarch", "page": 9999 },
    "expect": { "page": 880, "percent": 100 } },
  { "name": "starting a book from the pile", "operation": "set_progress", "input": { "bookId": "piranesi", "page": 0 },
    "expect": { "bookId": "piranesi", "page": 0, "percent": 0 } },
  { "name": "started book is now being read", "operation": "list_books", "input": { "status": "reading" },
    "expect": { "books": [{ "title": "Piranesi", "page": 0 }, { "title": "Middlemarch", "page": 880 }] } },
  { "name": "finish with a rating", "operation": "finish_book", "input": { "bookId": "middlemarch", "rating": 5, "date": "2026-10-30" },
    "expect": { "bookId": "middlemarch", "finishedOn": "2026-10-30" } },
  { "name": "finish without a rating", "operation": "finish_book", "input": { "bookId": "piranesi" },
    "expect": { "bookId": "piranesi", "finishedOn": "$any" } },
  { "name": "finished books carry rating and date", "operation": "list_books", "input": { "status": "finished" },
    "expect": { "books": [{ "title": "Piranesi", "page": 272 }, { "title": "Middlemarch", "rating": 5, "finishedOn": "2026-10-30", "page": 880 }] } },
  { "name": "a finished book takes no more pages", "operation": "set_progress", "input": { "bookId": "middlemarch", "page": 10 }, "expectError": true },
  { "name": "nightstand empties when books are finished", "operation": "widget_nightstand", "input": {},
    "expect": { "small": { "template": "stat", "value": 0 }, "medium": { "items": [] } } },
  { "name": "remove a book", "operation": "remove_book", "input": { "bookId": "piranesi-2" }, "expect": { "removed": true } },
  { "name": "removing it again finds nothing", "operation": "remove_book", "input": { "bookId": "piranesi-2" }, "expect": { "removed": false } }
]
