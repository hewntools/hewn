    {
      "name": "dark_window",
      "version": 1,
      "description": "When it is dark enough for aurora at the owner's place on a night (sun below −12°, computed locally, no network), and how bright the moon is. dark is false when it never gets that dark (around midsummer, far north). The default night is tonight: the current local date's night, or last night while it is still dark in the early hours. Errors before a place is chosen.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Local date the evening starts (YYYY-MM-DD); defaults to tonight"
          },
          "now": {
            "type": "string",
            "description": "Optional ISO instant to resolve tonight at; for replays and tests"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "date",
          "dark",
          "dark_start",
          "dark_end",
          "dark_start_local",
          "dark_end_local",
          "dark_hours",
          "moon_brightness",
          "moon_label"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "dark": {
            "type": "boolean"
          },
          "dark_start": {
            "type": [
              "string",
              "null"
            ],
            "description": "UTC ISO time"
          },
          "dark_end": {
            "type": [
              "string",
              "null"
            ],
            "description": "UTC ISO time"
          },
          "dark_start_local": {
            "type": [
              "string",
              "null"
            ],
            "description": "HH:MM in the place's time zone"
          },
          "dark_end_local": {
            "type": [
              "string",
              "null"
            ],
            "description": "HH:MM in the place's time zone"
          },
          "dark_hours": {
            "type": "integer",
            "description": "Length of the dark window, rounded to whole hours"
          },
          "moon_brightness": {
            "type": "number",
            "description": "0 (new, dark) to 1 (full, bright), computed locally"
          },
          "moon_label": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "widget_aurora",
      "version": 1,
      "description": "Widget: the forecast fetch_tonight stored for tonight at the owner's place (the current local date's night, or last night while it is still dark in the early hours). Small shows the rating word and, when it fits, a short line (cloud cover, or the best hour); large lists the rating, Kp, cloud cover, dark window, moon brightness, verdict, best hour and when it was fetched. Before tonight is fetched it shows the dark window and moon (known offline) with Refresh; before a place is chosen it says to choose one. Reads only stored data.",
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Night to show (YYYY-MM-DD); defaults to tonight"
          },
          "now": {
            "type": "string",
            "description": "Optional ISO instant to resolve tonight at; for replays and tests"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    }
  ],
  "widgets": [
    {
      "name": "aurora",
      "version": 1,
      "title": "Aurora tonight",
      "operation": "widget_aurora@1",
      "sizes": [
        "small",
        "large"
      ],
      "refresh": {
        "every": "30m"
      }
    }
  ]
}
