  { "name": "rejects an empty name", "operation": "add_kid", "version": 1, "input": { "name": "   " }, "expectError": true },

  { "name": "unknown kid name is an error", "operation": "add_quote", "version": 1, "input": { "text": "Hello", "kid": "Otto" }, "expectError": true },
  { "name": "unknown kid id is an error", "operation": "add_quote", "version": 1, "input": { "text": "Hello", "kid": 99 }, "expectError": true },
  { "name": "empty text is an error", "operation": "add_quote", "version": 1, "input": { "text": "", "kid": "Ada" }, "expectError": true },
  { "name": "blank text is an error", "operation": "add_quote", "version": 1, "input": { "text": "    ", "kid": "Ada" }, "expectError": true },
  { "name": "text over 500 characters is an error", "operation": "add_quote", "version": 1,
