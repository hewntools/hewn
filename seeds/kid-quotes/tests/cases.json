  { "name": "leap-day kid on a real Feb 29", "operation": "add_quote", "version": 1, "input": { "text": "A real birthday!", "kid": "Nora", "said_on": "2020-02-29" },
    "expect": { "id": 6, "age_at_time": "4 y" } },
  { "name": "leap-day kid on Mar 1", "operation": "add_quote", "version": 1, "input": { "text": "Spring is when the snow gets tired.", "kid": "Nora", "said_on": "2019-03-01" },
