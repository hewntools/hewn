    "expect": { "id": 1, "kid": "Ada", "kid_id": 1, "text": "Why is the moon following us?", "context": "in the car", "said_on": "2025-03-20", "age_at_time": "4 y 7 m" } },
  { "name": "widget with one quote", "operation": "widget_kid_quote", "version": 1, "input": { "date": "2026-10-11" },
    "expect": {
