      "large": { "template": "text", "text": "\"Why is the moon following us?\" — Ada, 4 y 7 m, March 2025", "caption": "1 quote saved", "buttons": [{ "label": "Another", "operation": "next_widget_quote@1" }] }
    } },

  { "name": "age on the birthday itself", "operation": "add_quote", "version": 1, "input": { "text": "I am four now.", "kid": "Ada", "said_on": "2024-08-15" },
