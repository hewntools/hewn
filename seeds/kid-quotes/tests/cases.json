  { "name": "adds a leap-day kid", "operation": "add_kid", "version": 1, "input": { "name": "Nora", "birthdate": "2016-02-29" },
    "expect": { "id": 3, "name": "Nora", "birthdate": "2016-02-29" } },
  { "name": "rejects an impossible birthdate", "operation": "add_kid", "version": 1, "input": { "name": "Ben", "birthdate": "2021-02-30" }, "expectError": true },
