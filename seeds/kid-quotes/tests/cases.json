  { "name": "leap-day kid has a birthday on Feb 28 in other years", "operation": "add_quote", "version": 1, "input": { "text": "Is it my birthday or not?", "kid": "Nora", "said_on": "2017-02-28" },
    "expect": { "id": 4, "age_at_time": "1 y" } },
  { "name": "leap-day kid the day before", "operation": "add_quote", "version": 1, "input": { "text": "Cake?", "kid": "Nora", "said_on": "2017-02-27" },
