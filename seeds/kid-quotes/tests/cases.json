  { "name": "said_on before the birthdate is an error", "operation": "add_quote", "version": 1, "input": { "text": "Hello", "kid": "Ada", "said_on": "2020-01-01" }, "expectError": true },

  { "name": "adds a quote with the age at the time", "operation": "add_quote", "version": 1,
