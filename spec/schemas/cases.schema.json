{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hewn.tools/spec/2/cases.schema.json",
  "title": "Hewn tool test cases (tests/cases.json), ABI 2",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "name",
      "operation"
    ],
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "operation": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "input": {},
      "secrets": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "config": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      },
      "calls": {
        "type": "object",
        "propertyNames": {
          "pattern": "^[a-z0-9][a-z0-9-]*/[a-z][a-z0-9_]*@[0-9]+$"
        }
      },
      "model": {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "error"
              ],
              "properties": {
                "error": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string"
                },
                "json": {}
              }
            }
          ]
        }
      },
      "expect": {},
      "expectError": {
        "type": "boolean"
      }
    }
  }
}
