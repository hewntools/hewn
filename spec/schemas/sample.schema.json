{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hewn.tools/spec/2/sample.schema.json",
  "title": "Hewn tool sample data (sample/calls.json), ABI 2.5",
  "type": "array",
  "minItems": 1,
  "maxItems": 200,
  "items": {
    "type": "object",
    "required": [
      "operation"
    ],
    "additionalProperties": false,
    "properties": {
      "operation": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "input": {}
    }
  }
}
