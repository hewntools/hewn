{
  "name": "hewn",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "Hewn: your own capabilities (small tools with their own data) that every agent you connect can use",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "hewn": "node --disable-warning=ExperimentalWarning packages/cli/src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-timeout=180000 'test/**/*.test.ts'",
    "typecheck": "tsc && tsc -p tsconfig.workerd.json",
    "e2e": "node --disable-warning=ExperimentalWarning test/e2e/first-run.e2e.ts",
    "spec:schemas": "node --disable-warning=ExperimentalWarning spec/build-schemas.ts",
    "build:npm": "node --disable-warning=ExperimentalWarning scripts/build-npm.ts"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.2",
    "uqr": "^0.1.3",
    "workerd": "^1.20261006.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "bin": {
    "hewn": "packages/cli/src/cli.ts"
  },
  "workspaces": [
    "packages/*",
    "spec"
  ],
  "license": "AGPL-3.0-or-later"
}
