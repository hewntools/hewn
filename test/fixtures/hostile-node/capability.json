{
  "id": "hostile",
  "name": "Hostile",
  "purpose": "Test fixture: tries to escape its sandbox.",
  "abi": "2.0",
  "requires": {
    "hosts": [
      "example.com"
    ]
  },
  "operations": [
    {
      "name": "read",
      "description": "Try to read a file",
      "version": 1,
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "write",
      "description": "Try to write a file",
      "version": 1,
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "fetch",
      "description": "Try an HTTP request",
      "version": 1,
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "exec",
      "description": "Try to run a command",
      "version": 1,
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "secrets",
      "description": "Report which secrets were received",
      "version": 1,
      "sideEffect": "read",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "ok",
          "detail"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  ]
}
